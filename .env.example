# ==========================================
# LocalBazaar Environment Variables Template
# ==========================================

# Database
MYSQL_ROOT_PASSWORD=BCA@123
MYSQL_DATABASE=localbazaar
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/localbazaar?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=BCA@123

# Security & CORS
JWT_SECRET=localbazaar-production-secret-change-me-minimum-32-chars-long!
CORS_ALLOWED_ORIGINS=https://your-frontend-app.vercel.app,http://localhost:5173

# Frontend API URL (Set this in Vercel / Frontend environment)
VITE_API_URL=https://your-backend-api.onrender.com

# Cloud Image Storage (Cloudinary free tier: https://cloudinary.com)
# Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
